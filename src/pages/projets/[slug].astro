---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { getFeaturedProjects } from '../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getFeaturedProjects('fr');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
---

<Base title={project.title} description={project.summary}>
  <CaseStudy project={project} />
</Base>
