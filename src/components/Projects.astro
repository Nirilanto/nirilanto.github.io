---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { getFeaturedProjects } from '../lib/content';
import { localePath, toLocale, useTranslations } from '../i18n';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const projects = await getFeaturedProjects(locale);
---

<section id="projets" class="section container-page" aria-labelledby="projets-title">
  <SectionHeading
    index="01"
    label={t('nav.projects')}
    title={t('projects.title')}
    outline={t('projects.titleOutline')}
    id="projets-title"
  />

  <ol class="flex flex-col gap-20 md:gap-32">
    {projects.map((project, i) => (
      <li>
        <article class:list={['project', i % 2 === 1 && 'project-flip']}>
          <div
            class="placeholder-visual project-visual"
            data-clip
            transition:name={`visuel-${project.slug}`}
          >
            <div class="placeholder-visual-fill" />
            <p class="placeholder-visual-caption">
              {project.anonymised ? t('projects.visualAnon') : t('projects.visual')}
            </p>
          </div>

          <div class="project-body">
            <p class="label" data-reveal>
              {String(i + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')} —{' '}
              {project.client}
            </p>
            <h3 class="project-title mt-4" data-reveal>
              <a
                href={localePath(locale, `/projets/${project.slug}/`)}
                class="project-link"
                transition:name={`titre-${project.slug}`}
              >
                {project.title}
              </a>
            </h3>
            <p class="text-muted mt-3 font-mono text-xs tracking-wider uppercase" data-reveal>
              {project.role} · {project.period}
            </p>
            <p class="text-lead mt-6 max-w-[52ch] leading-snug" data-reveal>
              {project.summary}
            </p>
            <ul class="mt-6 flex flex-wrap gap-2" data-reveal>
              {project.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
            <p class="project-cta mt-8" aria-hidden="true" data-reveal>
              {t('projects.view')}
              <Icon name="arrow-right" />
            </p>
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>

<style>
  .project {
    position: relative;
    display: grid;
    gap: 2rem;
  }
  .project-visual {
    aspect-ratio: 16 / 10;
  }
  .project-title {
    font-size: clamp(2.75rem, 8vw, 7.5rem);
    line-height: 0.95;
  }
  /* Tout le bloc est cliquable, le lien reste le titre. */
  .project-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .project-link {
    transition: color var(--duration-fast) var(--ease-expo);
  }
  .project:hover .project-link,
  .project-link:focus-visible {
    color: var(--color-accent);
  }
  .project:hover :global(.placeholder-visual-fill) {
    transform: scale(1.08) rotate(1.5deg);
  }
  .project-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .project-cta :global(svg) {
    transition: transform var(--duration-fast) var(--ease-expo);
  }
  .project:hover .project-cta :global(svg) {
    transform: translateX(6px);
  }
  @media (min-width: 64rem) {
    .project {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2.5rem, 5vw, 6rem);
    }
    .project-flip .project-visual {
      order: 2;
    }
    .project-title {
      font-size: clamp(3.5rem, 6.2vw, 7.5rem);
    }
  }
</style>
