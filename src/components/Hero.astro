---
import { Picture } from 'astro:assets';
import portrait from '../assets/venerand-detoure.png';
import portraitNight from '../assets/venerand-nuit.jpg';
import Icon from './Icon.astro';
import { heroCopy, profile, site } from '../data/site';
import { toLocale, useTranslations } from '../i18n';
import { getTechLogo } from '../lib/techLogos';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { titleParts, location } = profile[locale];
const [role] = titleParts;
const copy = heroCopy[locale];
// Technologies, en logos seuls : une seule bande qui défile.
const resolve = (names: string[]) =>
  names.flatMap((name) => {
    const logo = getTechLogo(name);
    if (!logo) return [];
    const id = `tech-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
    return [{ name, id, ...logo }];
  });
const techRows = [
  resolve([
    'React',
    'Next.js',
    'Vue.js',
    'Angular',
    'TypeScript',
    'JavaScript',
    'HTML5',
    'CSS',
    'Tailwind',
    'Node.js',
    'NestJS',
    'GraphQL',
    'PostgreSQL',
    'MongoDB',
    'MariaDB',
    'Elasticsearch',
    'Kafka',
    'Claude',
    'MCP',
    'Anthropic',
    'Git',
    'GitHub',
    'GitHub Actions',
    'GitLab CI/CD',
    'Docker',
    'Kubernetes',
    'Jenkins',
    'Jest',
    'Cypress',
    'SonarCloud',
    'Keycloak',
    'Figma',
    'Jira',
  ]),
];
// La bande est répétée pour boucler sans raccord, même sur un écran très large.
const COPIES = 4;
const statementText = copy.statement.map((part) => part.text).join('');
---

<section id="accueil" class="hero relative overflow-clip" aria-labelledby="hero-title" data-hero>
  <!-- Les rubans animés vivent dans Base.astro : calque fixe, commun à toutes les pages.
       Pas de contexte d'empilement ici, pour que le portrait passe devant eux. -->
  <div class="hero-grid container-page">
    <!-- L'étiquette et la pastille d'expérience sont dans l'en-tête ; sur les écrans
         trop étroits pour les y loger, elles restent ici. -->
    <div class="hero-label flex flex-wrap items-center gap-x-4 gap-y-2 xl:hidden" data-hero-fade>
      <p class="label">
        {t('hero.label')} — {location}
      </p>
      <p class="pill">
        <span class="pill-dot" aria-hidden="true"></span>
        {copy.experience}
      </p>
    </div>

    <figure class="hero-figure" data-hero-figure>
      <Picture
        src={portrait}
        alt={t('hero.portraitAlt')}
        formats={['avif', 'webp']}
        widths={[360, 540, 720, 1080]}
        sizes="(min-width: 64rem) 34vw, 72vw"
        loading="eager"
        fetchpriority="high"
        class="hero-portrait"
        data-hero-portrait
      />
      <!-- Thème sombre : portrait sur fond noir, fondu dans la page -->
      <div class="hero-night" data-hero-portrait>
        <Picture
          src={portraitNight}
          alt={t('hero.portraitAlt')}
          formats={['avif', 'webp']}
          widths={[360, 540, 720, 1080]}
          sizes="(min-width: 64rem) 34vw, 72vw"
          loading="lazy"
          class="hero-night-img"
        />
      </div>
      <!-- Sceau rotatif -->
      <div class="hero-badge" aria-hidden="true" data-hero-fade>
        <svg viewBox="0 0 160 160" class="hero-badge-ring">
          <defs>
            <path id="hero-badge-path" d="M80 80m-62 0a62 62 0 1 1 124 0a62 62 0 1 1 -124 0"></path>
          </defs>
          <text textLength="386" lengthAdjust="spacing">
            <textPath href="#hero-badge-path">{t('hero.badge')}</textPath>
          </text>
        </svg>
        <span class="hero-badge-core">
          <Icon name="arrow-down" size={22} />
        </span>
      </div>
    </figure>

    <!-- Le nom reste le titre de la page ; il se range sous le portrait, avec le rôle. -->
    <div class="hero-id">
      <h1 id="hero-title" class="hero-name" aria-label={site.name}>
        <span class="hero-line" aria-hidden="true" data-hero-line>
          {site.firstName}
        </span>
        <span class="hero-line outline-text" aria-hidden="true" data-hero-line>
          {site.lastName}
        </span>
      </h1>
      <p class="text-muted mt-2 font-mono text-xs tracking-wider uppercase" data-hero-fade>
        {role}
      </p>
    </div>

    <div class="hero-info" data-hero-info>
      <div>
        <!-- Phrase d'accroche : barre oblique, mots-clés en couleur d'accent. -->
        <p class="hero-statement" aria-label={statementText} data-hero-fade>
          <span class="hero-slash" aria-hidden="true"></span>
          <span aria-hidden="true">
            {copy.statement.map((part) =>
              part.mark ? (
                <span class:list={['hero-mark', `hero-mark-${part.mark}`]} data-hero-mark>
                  <span class="hero-mark-text">{part.text}</span>
                </span>
              ) : (
                part.text
              ),
            )}
          </span>
        </p>
        <div class="mt-7 flex flex-wrap gap-3" data-hero-fade>
          <a href="#projets" class="btn btn-primary" data-magnetic>
            {t('hero.projects')}
            <Icon name="arrow-down" />
          </a>
          <a href="#contact" class="btn" data-magnetic>
            {t('nav.contact')}
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>

    <!-- Trois piliers : une ligne éditoriale fine, sous un filet dégradé. -->
    <ul class="hero-chips" data-hero-fade>
      {copy.pillars.map((pillar, i) => (
        <li class="hero-chip">
          <span class="hero-chip-index">{String(i + 1).padStart(2, '0')}</span>
          <Icon name={pillar.icon} size={15} class="hero-chip-icon" />
          <span class="hero-chip-label">{pillar.label}</span>
        </li>
      ))}
    </ul>

    <!-- Technologies : une bande de logos qui défile, tout en bas à gauche.
         Les tracés sont définis une fois (symboles) puis réutilisés par chaque tuile. -->
    <div class="hero-tech" data-hero-fade>
      <svg class="sr-only" aria-hidden="true" focusable="false">
        {techRows.flat().map((item) => (
          <symbol id={item.id} viewBox="0 0 24 24">
            <path d={item.path} />
          </symbol>
        ))}
      </svg>
      {techRows.map((row, r) => (
        <div class:list={['hero-tech-row', r % 2 === 1 && 'hero-tech-row-reverse']}>
          <div class="hero-tech-track">
            {Array.from({ length: COPIES }, (_, copy) => (
              <ul
                class="hero-tech-list"
                aria-label={copy === 0 ? t('about.stack') : undefined}
                aria-hidden={copy > 0 ? 'true' : undefined}
              >
                {row.map((item) => (
                  <li
                    class="hero-tech-tile"
                    title={item.name}
                    style={`--c: ${item.colour === 'currentColor' ? 'var(--color-fg)' : item.colour}`}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <use href={`#${item.id}`} />
                    </svg>
                    {copy === 0 && <span class="sr-only">{item.name}</span>}
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Mobile : étiquette, portrait, nom, accroche, piliers.
     Bureau : portrait puis nom à droite, tout le reste à gauche. */
  .hero-grid {
    display: grid;
    grid-template-areas: 'label' 'figure' 'id' 'info' 'chips' 'tech';
    row-gap: 1.5rem;
    min-height: 100svh;
    padding-top: calc(var(--nav-h) + 1rem);
  }
  .hero-label {
    grid-area: label;
  }
  .hero-id {
    grid-area: id;
    /* Sous le portrait, aligné comme lui. */
    display: grid;
    justify-items: end;
    text-align: right;
  }
  .hero-figure {
    grid-area: figure;
  }
  .hero-info {
    grid-area: info;
    display: grid;
    gap: 2rem;
  }
  .hero-name {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.28em;
    font-size: clamp(2rem, 3.5vw, 4rem);
    line-height: 1.05;
  }
  .hero-line {
    display: inline-block;
  }
  @media (min-width: 64rem) {
    .hero-grid {
      /* À gauche, le texte calé en haut ; à droite, le portrait. Dernière rangée :
         les logos à gauche, le nom à droite, sur la même ligne ; les piliers juste au-dessus. */
      grid-template-columns: minmax(0, 1fr) clamp(20rem, 35vw, 44rem);
      grid-template-rows: auto auto 1fr auto auto;
      grid-template-areas:
        'label figure'
        'info figure'
        '. figure'
        'chips figure'
        'tech id';
      column-gap: clamp(2rem, 4vw, 5rem);
      row-gap: 0;
    }
    .hero-id {
      position: relative;
      z-index: 12; /* devant le calque des rubans, comme le portrait */
      justify-items: center;
      padding-top: 1rem;
      padding-bottom: clamp(1rem, 3svh, 2rem);
      text-align: center;
    }
    .hero-name {
      justify-content: center;
    }
    .hero-info {
      gap: 2.25rem;
      padding-top: clamp(0.5rem, 2svh, 1.25rem);
    }
  }

  /* Phrase d'accroche avec barre oblique */
  .hero-statement {
    position: relative;
    max-width: 14.5em;
    padding-left: 0.62em;
    font-family: var(--font-display);
    font-size: clamp(2rem, min(3.85vw, 7.6svh), 5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.12;
  }
  .hero-slash {
    position: absolute;
    left: 0.2em;
    top: 0.12em;
    bottom: 0.12em;
    width: 0.07em;
    border-radius: 0.07em;
    background: var(--color-accent);
    transform: skewX(-6deg);
  }
  /* Mots-clés : simplement en couleur d'accent, sans cartouche. */
  .hero-mark {
    color: var(--color-accent);
    white-space: nowrap;
  }
  .hero-mark-text {
    position: relative;
  }

  /* Technologies : une bande de tuiles qui défile */
  .hero-tech {
    grid-area: tech;
    display: grid;
    gap: 0.6rem;
    min-width: 0;
    padding-bottom: 2.5rem;
  }
  @media (min-width: 64rem) {
    /* En bas à gauche, à la hauteur du nom. */
    .hero-tech {
      align-self: center;
      padding-bottom: clamp(1rem, 3svh, 2rem);
    }
  }
  .hero-tech-row {
    overflow: hidden;
    /* Marge pour que le survol (tuile soulevée, halo) ne soit pas rogné. */
    padding-block: 0.6rem;
    margin-block: -0.6rem;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .hero-tech-track {
    display: flex;
    width: max-content;
    animation: hero-tech-scroll 90s linear infinite;
  }
  .hero-tech-row-reverse .hero-tech-track {
    animation-direction: reverse;
    animation-duration: 56s;
  }
  /* Le défilement s'arrête quand on survole la bande, pour viser un logo. */
  .hero-tech-row:hover .hero-tech-track {
    animation-play-state: paused;
  }
  @keyframes hero-tech-scroll {
    to {
      transform: translateX(-25%); /* une copie sur quatre */
    }
  }
  .hero-tech-list {
    display: flex;
  }
  .hero-tech-tile {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    margin-right: 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--color-card) 70%, transparent);
    color: var(--c);
    transition:
      transform var(--duration-fast) var(--ease-expo),
      border-color var(--duration-fast) var(--ease-expo),
      box-shadow var(--duration-fast) var(--ease-expo);
  }
  .hero-tech-tile svg {
    width: 1.45rem;
    height: 1.45rem;
    fill: currentColor;
    transition: transform var(--duration-fast) var(--ease-expo);
  }
  .hero-tech-tile:hover {
    transform: translateY(-5px);
    border-color: var(--c);
    box-shadow: 0 12px 26px -12px var(--c);
  }
  .hero-tech-tile:hover svg {
    transform: scale(1.18) rotate(-6deg);
  }
  /* Mouvement réduit : pas de défilement, une seule copie, sur plusieurs lignes. */
  @media (prefers-reduced-motion: reduce) {
    .hero-tech-row {
      mask-image: none;
    }
    .hero-tech-track {
      width: auto;
      animation: none;
    }
    .hero-tech-list {
      flex-wrap: wrap;
      row-gap: 0.6rem;
    }
    .hero-tech-list[aria-hidden] {
      display: none;
    }
  }

  /* Trois piliers : ligne éditoriale — numéro, pictogramme au trait, libellé */
  .hero-chips {
    grid-area: chips;
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding-top: 0.9rem;
    padding-bottom: 1.25rem;
  }
  /* Filet qui s'estompe vers la droite. */
  .hero-chips::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), transparent 85%);
    opacity: 0.55;
  }
  .hero-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }
  .hero-chip-index {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .hero-chip :global(.hero-chip-icon) {
    flex: none;
    color: var(--color-accent);
    transition: transform var(--duration-fast) var(--ease-expo);
  }
  .hero-chip-label {
    position: relative;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  /* Survol : le pictogramme bascule, un trait se tire sous le libellé. */
  .hero-chip-label::after {
    content: '';
    position: absolute;
    inset: auto 0 -3px 0;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--duration-fast) var(--ease-expo);
  }
  .hero-chip:hover .hero-chip-label::after {
    transform: scaleX(1);
  }
  .hero-chip:hover :global(.hero-chip-icon) {
    transform: rotate(-10deg) scale(1.15);
  }
  @media (min-width: 64rem) {
    .hero-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem 0;
    }
    /* Séparateur oblique entre deux piliers. */
    .hero-chip + .hero-chip::before {
      content: '';
      width: 1px;
      height: 1rem;
      margin-inline: 1.1rem 0.6rem;
      background: var(--color-line);
      transform: skewX(-18deg);
    }
  }

  /* Portrait posé sur le bas du hero, sans panneau derrière. */
  .hero-figure {
    position: relative;
    z-index: 11; /* devant le calque des rubans (z 10) : ils passent derrière la silhouette */
    align-self: end;
    justify-self: end;
    /* Mobile : portrait réduit pour que l'accroche commence dans le premier écran. */
    width: min(56%, 20rem);
    aspect-ratio: 3 / 4;
  }
  @media (min-width: 64rem) {
    .hero-figure {
      width: 100%;
      /* Hauteur d'écran moins l'en-tête et le bloc du nom en dessous. */
      max-height: calc(100svh - var(--nav-h) - 9rem);
    }
  }
  .hero-figure :global(.hero-portrait) {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }

  /* Thème sombre : même cadre que le portrait clair, photo sur fond noir. */
  .hero-night {
    display: none;
    position: absolute;
    inset: 0;
  }
  /* Le fond noir de la photo disparaît : seuls le visage et la chemise restent devant les rubans. */
  :global([data-theme='dark']) .hero-figure {
    mix-blend-mode: lighten;
  }
  .hero-night :global(.hero-night-img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }
  :global([data-theme='dark']) .hero-night {
    display: block;
  }
  :global([data-theme='dark']) .hero-figure :global(.hero-portrait) {
    display: none;
  }

  .hero-line {
    /* Marge pour que le masque ne rogne pas le contour des lettres. */
    padding-block: 0.04em;
  }

  .hero-badge {
    position: absolute;
    left: -3.25rem;
    bottom: 14%;
    display: grid;
    place-items: center;
    width: clamp(6.5rem, 9.5vw, 9rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-fg);
  }
  @media (min-width: 64rem) {
    .hero-badge {
      /* En haut à droite du portrait, au-dessus du sommaire latéral. */
      left: auto;
      right: -0.5rem;
      bottom: auto;
      top: 4%;
    }
  }
  .hero-badge-ring {
    position: absolute;
    inset: 0;
    animation: hero-badge-spin 28s linear infinite;
  }
  .hero-badge-ring text {
    fill: currentColor;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    text-transform: uppercase;
  }
  .hero-badge-core {
    display: grid;
    place-items: center;
    width: 42%;
    aspect-ratio: 1;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-accent);
  }
  @keyframes hero-badge-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* État initial avant l'animation d'entrée : uniquement si JS et mouvement autorisés.
     Le filet de sécurité réaffiche tout si le script ne s'exécute pas. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-hero]:not([data-hero-ready]) [data-hero-line],
    :global(.js) [data-hero]:not([data-hero-ready]) [data-hero-fade],
    :global(.js) [data-hero]:not([data-hero-ready]) :global([data-hero-portrait]) {
      opacity: 0;
      animation: hero-failsafe 0s linear 4s forwards;
    }
  }
  @keyframes hero-failsafe {
    to {
      opacity: 1;
    }
  }
</style>

<script>
  import { animate, stagger } from 'motion';
  import { DURATION, EASE, prefersReducedMotion } from '../lib/motion';
  import { splitText } from '../lib/splitText';

  async function initHero() {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero || hero.dataset.heroReady) return;
    if (prefersReducedMotion()) {
      hero.dataset.heroReady = 'true';
      return;
    }

    // Les lettres sont mesurées une fois la police d'affichage chargée.
    await Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1200))]);

    const lines = [...hero.querySelectorAll<HTMLElement>('[data-hero-line]')];
    const fades = [...hero.querySelectorAll<HTMLElement>('[data-hero-fade]')];
    const photo = [...hero.querySelectorAll<HTMLElement>('[data-hero-portrait]')];
    const splits = lines.map((line) => splitText(line, 'chars'));
    const chars = splits.flatMap((split) => split.units);

    // État de départ posé avant de lever le voile (data-hero-ready).
    chars.forEach((char) => {
      char.style.transformOrigin = '0% 100%';
      char.style.transform = 'translateY(115%) rotate(9deg)';
    });
    [...fades, ...photo].forEach((el) => (el.style.opacity = '0'));
    hero.dataset.heroReady = 'true';

    const letters = animate(
      chars,
      { y: ['115%', '0%'], rotate: [9, 0] },
      { duration: DURATION.slow, ease: EASE, delay: stagger(0.04) },
    );
    animate(
      photo,
      { y: ['6%', '0%'], opacity: [0, 1] },
      { duration: DURATION.slow, ease: EASE, delay: 0.35 },
    );
    animate(
      fades,
      { y: [24, 0], opacity: [0, 1] },
      { duration: DURATION.base, ease: EASE, delay: stagger(0.08, { startDelay: DURATION.fast }) },
    );
    void letters.finished.then(() => splits.forEach((split) => split.revert()));
  }

  document.addEventListener('astro:page-load', initHero);
</script>
