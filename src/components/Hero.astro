---
import { Picture } from 'astro:assets';
import portrait from '../assets/venerand-detoure.png';
import portraitNight from '../assets/venerand-nuit.jpg';
import Icon from './Icon.astro';
import ThreadsStatic from './ThreadsStatic.astro';
import WeaveCanvas from './webgl/WeaveCanvas.tsx';
import { heroCopy, profile, site } from '../data/site';
import { toLocale, useTranslations } from '../i18n';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { titleParts, location } = profile[locale];
const [role] = titleParts;
const copy = heroCopy[locale];
const statementText = copy.statement.map((part) => part.text).join('');
---

<section class="hero bg-bg relative isolate overflow-clip" aria-labelledby="hero-title" data-hero>
  <!-- Repli statique, derrière le texte. -->
  <div class="hero-static text-accent absolute inset-0 -z-10" aria-hidden="true">
    <ThreadsStatic />
  </div>
  <!-- Rubans animés, par-dessus le texte en mode fusion (verre teinté). -->
  <div class="hero-glass" aria-hidden="true">
    <WeaveCanvas client:idle />
  </div>

  <div class="hero-grid container-page">
    <div class="hero-head">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2" data-hero-fade>
        <p class="label">
          {t('hero.label')} — {location}
        </p>
        <p class="hero-pill">
          <span class="hero-pill-dot" aria-hidden="true"></span>
          {copy.experience}
        </p>
      </div>

      <!-- Le nom reste le titre de la page, mais c'est l'accroche qui porte le hero. -->
      <div class="mt-6 flex flex-wrap items-baseline gap-x-5 gap-y-1">
        <h1 id="hero-title" class="hero-name" aria-label={site.name}>
          <span class="hero-line" aria-hidden="true" data-hero-line>
            {site.firstName}
          </span>
          <span class="hero-line outline-text" aria-hidden="true" data-hero-line>
            {site.lastName}
          </span>
        </h1>
        <p class="text-muted font-mono text-xs tracking-wider uppercase" data-hero-fade>
          {role}
        </p>
      </div>
    </div>

    <figure class="hero-figure" data-hero-figure>
      <Picture
        src={portrait}
        alt={t('hero.portraitAlt')}
        formats={['avif', 'webp']}
        widths={[360, 540, 720, 1080]}
        sizes="(min-width: 64rem) 34vw, 72vw"
        loading="eager"
        fetchpriority="high"
        class="hero-portrait"
        data-hero-portrait
      />
      <!-- Thème sombre : portrait sur fond noir, fondu dans la page -->
      <div class="hero-night" data-hero-portrait>
        <Picture
          src={portraitNight}
          alt={t('hero.portraitAlt')}
          formats={['avif', 'webp']}
          widths={[360, 540, 720, 1080]}
          sizes="(min-width: 64rem) 34vw, 72vw"
          loading="lazy"
          class="hero-night-img"
        />
      </div>
      <!-- Sceau rotatif -->
      <div class="hero-badge" aria-hidden="true" data-hero-fade>
        <svg viewBox="0 0 160 160" class="hero-badge-ring">
          <defs>
            <path id="hero-badge-path" d="M80 80m-62 0a62 62 0 1 1 124 0a62 62 0 1 1 -124 0"></path>
          </defs>
          <text textLength="386" lengthAdjust="spacing">
            <textPath href="#hero-badge-path">{t('hero.badge')}</textPath>
          </text>
        </svg>
        <span class="hero-badge-core">
          <Icon name="arrow-down" size={22} />
        </span>
      </div>
    </figure>

    <div class="hero-info" data-hero-info>
      <div>
        <!-- Phrase d'accroche : barre oblique, mots surlignés qui se remplissent à l'entrée. -->
        <p class="hero-statement" aria-label={statementText} data-hero-fade>
          <span class="hero-slash" aria-hidden="true"></span>
          <span aria-hidden="true">
            {copy.statement.map((part) =>
              part.mark ? (
                <span class:list={['hero-mark', `hero-mark-${part.mark}`]} data-hero-mark>
                  <span class="hero-mark-text">{part.text}</span>
                </span>
              ) : (
                part.text
              ),
            )}
          </span>
        </p>
        <div class="mt-7 flex flex-wrap gap-3" data-hero-fade>
          <a href="#projets" class="btn btn-primary" data-magnetic>
            {t('hero.projects')}
            <Icon name="arrow-down" />
          </a>
          <a href="#contact" class="btn" data-magnetic>
            {t('nav.contact')}
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>

      <ul class="hero-pillars">
        {copy.pillars.map((pillar, i) => (
          <li class="hero-pillar" data-hero-fade>
            <span class="hero-pillar-icon">
              <Icon name={pillar.icon} size={20} />
            </span>
            <span class="hero-pillar-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="hero-pillar-label">{pillar.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Mobile : titre, portrait, texte. Bureau : texte à gauche, portrait debout à droite. */
  .hero-grid {
    display: grid;
    grid-template-areas: 'head' 'figure' 'info';
    row-gap: 2rem;
    min-height: 100svh;
    padding-top: clamp(2rem, 6svh, 4rem); /* l'en-tête est masqué en haut de page */
  }
  .hero-head {
    grid-area: head;
  }
  .hero-figure {
    grid-area: figure;
  }
  .hero-info {
    grid-area: info;
    display: grid;
    gap: 2rem;
    padding-bottom: 2.5rem;
  }
  .hero-name {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.28em;
    font-size: clamp(1.75rem, 3vw, 3.25rem);
    line-height: 1.05;
  }
  .hero-line {
    display: inline-block;
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) clamp(18rem, 31vw, 34rem);
      grid-template-rows: auto 1fr;
      grid-template-areas: 'head figure' 'info figure';
      column-gap: clamp(2rem, 4vw, 5rem);
      row-gap: 2.5rem;
    }
    .hero-head {
      padding-top: clamp(0.5rem, 4svh, 3rem);
    }
    .hero-info {
      align-self: center;
      gap: 2.25rem;
      padding-bottom: 3.5rem;
    }
  }

  /* Pastille « +8 ans d'expérience » */
  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-bg));
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-pill-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-accent);
    animation: hero-pulse 2.4s var(--ease-expo) infinite;
  }
  @keyframes hero-pulse {
    50% {
      transform: scale(1.9);
      opacity: 0.35;
    }
  }

  /* Phrase d'accroche avec barre oblique et mots surlignés */
  .hero-statement {
    position: relative;
    max-width: 14.5em;
    padding-left: 0.62em;
    font-family: var(--font-display);
    font-size: clamp(2rem, min(3.85vw, 7.6svh), 5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.12;
  }
  .hero-slash {
    position: absolute;
    left: 0.2em;
    top: 0.12em;
    bottom: 0.12em;
    width: 0.07em;
    border-radius: 0.07em;
    background: var(--color-accent);
    transform: skewX(-6deg);
  }
  .hero-mark {
    position: relative;
    display: inline-block;
    padding-inline: 0.22em;
    margin-inline: -0.08em;
    white-space: nowrap;
  }
  .hero-mark::before {
    content: '';
    position: absolute;
    inset: 0.08em 0;
    border-radius: 0.28em;
    transform-origin: 0 50%;
    transition: transform var(--duration-slow) var(--ease-expo) 0.9s;
  }
  .hero-mark-soft::before {
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
  }
  .hero-mark-soft {
    color: var(--color-accent);
  }
  .hero-mark-solid::before {
    background: var(--color-accent);
    transform: rotate(-1.5deg);
  }
  .hero-mark-solid {
    color: var(--color-on-accent);
  }
  .hero-mark-text {
    position: relative;
  }

  /* Trois piliers */
  .hero-pillars {
    display: grid;
    gap: 0.5rem;
  }
  @media (min-width: 40rem) {
    .hero-pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 46rem;
    }
  }
  .hero-pillar {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem 0.6rem 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-card) 78%, transparent);
  }
  .hero-pillar-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }
  .hero-pillar-index {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-muted);
  }
  .hero-pillar-label {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  /* Portrait posé sur le bas du hero, sans panneau derrière. */
  .hero-figure {
    position: relative;
    z-index: 11; /* devant les rubans : ils passent derrière la silhouette */
    align-self: end;
    justify-self: end;
    width: min(72%, 20rem);
    aspect-ratio: 3 / 4;
  }
  @media (min-width: 64rem) {
    .hero-figure {
      width: 100%;
      max-height: calc(100svh - 3rem);
    }
  }
  .hero-figure :global(.hero-portrait) {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }

  /* Thème sombre : même cadre que le portrait clair, photo sur fond noir. */
  .hero-night {
    display: none;
    position: absolute;
    inset: 0;
  }
  /* Le fond noir de la photo disparaît : seuls le visage et la chemise restent devant les rubans. */
  :global([data-theme='dark']) .hero-figure {
    mix-blend-mode: lighten;
  }
  .hero-night :global(.hero-night-img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }
  :global([data-theme='dark']) .hero-night {
    display: block;
  }
  :global([data-theme='dark']) .hero-figure :global(.hero-portrait) {
    display: none;
  }

  .hero-glass {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    mix-blend-mode: var(--ribbon-blend);
  }
  .hero :global(.weave-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-expo);
  }
  .hero :global(.weave-canvas[data-ready='true']) {
    opacity: 1;
  }

  .hero-static :global(.threads-static) {
    width: 100%;
    height: 100%;
    opacity: 0.4;
    transition: opacity var(--duration-slow) var(--ease-expo);
  }
  /* Le tracé statique s'efface dès que le shader a pris le relais. */
  .hero:has(:global(.weave-canvas[data-ready='true'])) :global(.threads-static) {
    opacity: 0;
  }

  .hero-line {
    /* Marge pour que le masque ne rogne pas le contour des lettres. */
    padding-block: 0.04em;
  }

  .hero-badge {
    position: absolute;
    left: -3.25rem;
    bottom: 14%;
    display: grid;
    place-items: center;
    width: clamp(6.5rem, 9.5vw, 9rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-fg);
  }
  .hero-badge-ring {
    position: absolute;
    inset: 0;
    animation: hero-badge-spin 28s linear infinite;
  }
  .hero-badge-ring text {
    fill: currentColor;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    text-transform: uppercase;
  }
  .hero-badge-core {
    display: grid;
    place-items: center;
    width: 42%;
    aspect-ratio: 1;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-accent);
  }
  @keyframes hero-badge-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* État initial avant l'animation d'entrée : uniquement si JS et mouvement autorisés.
     Le filet de sécurité réaffiche tout si le script ne s'exécute pas. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-hero]:not([data-hero-ready]) .hero-mark-soft::before {
      transform: scaleX(0);
    }
    :global(.js) [data-hero]:not([data-hero-ready]) .hero-mark-solid::before {
      transform: rotate(-1.5deg) scaleX(0);
    }
    :global(.js) [data-hero]:not([data-hero-ready]) [data-hero-line],
    :global(.js) [data-hero]:not([data-hero-ready]) [data-hero-fade],
    :global(.js) [data-hero]:not([data-hero-ready]) :global([data-hero-portrait]) {
      opacity: 0;
      animation: hero-failsafe 0s linear 4s forwards;
    }
  }
  @keyframes hero-failsafe {
    to {
      opacity: 1;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { DURATION, EASE, prefersReducedMotion } from '../lib/motion';

  gsap.registerPlugin(SplitText);

  async function initHero() {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero || hero.dataset.heroReady) return;
    if (prefersReducedMotion()) {
      hero.dataset.heroReady = 'true';
      return;
    }

    // Les lettres sont mesurées une fois la police d'affichage chargée.
    await Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1200))]);

    const lines = hero.querySelectorAll<HTMLElement>('[data-hero-line]');
    const fades = hero.querySelectorAll<HTMLElement>('[data-hero-fade]');
    const split = SplitText.create(lines, { type: 'chars', mask: 'chars', aria: 'none' });

    gsap.set(split.chars, { yPercent: 115, rotate: 9, transformOrigin: '0% 100%' });
    gsap.set(fades, { y: 24, opacity: 0 });
    const photo = hero.querySelectorAll('[data-hero-portrait]');
    gsap.set(photo, { yPercent: 6, opacity: 0 });
    hero.dataset.heroReady = 'true';

    gsap
      .timeline({ defaults: { ease: EASE } })
      .to(split.chars, { yPercent: 0, rotate: 0, duration: DURATION.slow, stagger: 0.04 })
      .to(photo, { yPercent: 0, opacity: 1, duration: DURATION.slow }, 0.35)
      .to(fades, { y: 0, opacity: 1, duration: DURATION.base, stagger: 0.08 }, DURATION.fast);
  }

  document.addEventListener('astro:page-load', initHero);
</script>
