---
import TechTag from './TechTag.astro';
import { Picture } from 'astro:assets';
import portraitDay from '../assets/venenrand.jpeg';
import portraitNight from '../assets/venerand.jpeg';
import SectionHeading from './SectionHeading.astro';
import { about } from '../data/about';
import { profile } from '../data/site';
import { toLocale, useTranslations } from '../i18n';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const content = about[locale];
const { tagline } = profile[locale];
const photos = [
  { src: portraitDay, theme: 'day' },
  { src: portraitNight, theme: 'night' },
];
---

<section id="a-propos" class="section container-page" aria-labelledby="a-propos-title">
  <SectionHeading
    index="03"
    label={t('nav.about')}
    title={t('about.title')}
    outline={t('about.titleOutline')}
    id="a-propos-title"
  />

  <div class="about-grid">
    <!-- Photo : noir et blanc, couleurs au survol, anneau pointillé qui tourne. -->
    <figure class="about-photo" data-reveal>
      <svg class="about-ring" viewBox="0 0 200 200" aria-hidden="true">
        <circle
          cx="100"
          cy="100"
          r="98"
          fill="none"
          stroke="currentColor"
          stroke-width="0.8"
          stroke-dasharray="1.5 5"
          stroke-linecap="round"
        ></circle>
      </svg>
      {photos.map((photo, i) => (
        <div class:list={['about-disc', `about-disc-${photo.theme}`]} data-clip-circle>
          <Picture
            src={photo.src}
            alt={i === 0 ? t('hero.portraitAlt') : ''}
            formats={['avif', 'webp']}
            widths={[320, 480, 720]}
            sizes="(min-width: 64rem) 24rem, 70vw"
            loading="lazy"
            class="about-img"
          />
          <Picture
            src={photo.src}
            alt=""
            formats={['avif', 'webp']}
            widths={[320, 480, 720]}
            sizes="(min-width: 64rem) 24rem, 70vw"
            loading="lazy"
            class="about-img about-img-mono"
          />
        </div>
      ))}
    </figure>

    <div>
      <p class="about-lead" data-reveal-lines>
        {tagline}
      </p>

      <h3 class="label mt-14" data-reveal>
        {t('about.strengths')}
      </h3>
      <ol class="mt-6 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {content.strengths.map((item, i) => (
          <li class="border-line border-t pt-5" data-reveal>
            <span class="text-muted font-mono text-xs">{String(i + 1).padStart(2, '0')}</span>
            <p class="font-display mt-2 text-xl leading-tight font-semibold tracking-tight">
              {item.title}
            </p>
            <p class="text-muted mt-2">{item.text}</p>
          </li>
        ))}
      </ol>

      <div class="about-ai mt-14" data-reveal>
        <h3 class="font-display text-2xl leading-tight font-semibold tracking-tight md:text-3xl">
          {content.ai.title}
        </h3>
        <p class="mt-4 max-w-[62ch]">{content.ai.text}</p>
      </div>

      <h3 class="label mt-14" data-reveal>
        {t('about.stack')}
      </h3>
      <dl class="border-line mt-6 border-t">
        {content.stack.map((group) => (
          <div class="about-stack border-line border-b" data-reveal>
            <dt class="font-display text-lg font-semibold tracking-tight">{group.label}</dt>
            <dd>
              <ul class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <TechTag name={item} />
                ))}
              </ul>
            </dd>
          </div>
        ))}
        <div class="about-stack" data-reveal>
          <dt class="font-display text-lg font-semibold tracking-tight">{t('about.sectors')}</dt>
          <dd class="text-muted">{content.sectors}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: 3rem;
  }
  .about-photo {
    position: relative;
    width: min(70vw, 20rem);
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .about-ring {
    position: absolute;
    inset: -7%;
    width: 114%;
    height: 114%;
    color: var(--color-accent);
    animation: about-spin 40s linear infinite;
  }
  @keyframes about-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .about-disc {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
    background: var(--color-card);
  }
  .about-disc-night,
  :global([data-theme='dark']) .about-disc-day {
    display: none;
  }
  :global([data-theme='dark']) .about-disc-night {
    display: block;
  }
  .about-disc :global(.about-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
    transform: scale(1.25);
    transform-origin: 50% 20%;
  }
  /* Calque noir et blanc par-dessus : seul son opacité s'anime. */
  .about-disc :global(.about-img-mono) {
    filter: grayscale(1) contrast(1.05);
    transition: opacity var(--duration-base) var(--ease-expo);
  }
  .about-photo:hover :global(.about-img-mono) {
    opacity: 0;
  }
  .about-lead {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.12;
    max-width: 24ch;
  }
  .about-ai {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 1.25rem 1.25rem 0;
    background: var(--color-card);
  }
  .about-stack {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.25rem;
  }
  @media (min-width: 48rem) {
    .about-stack {
      grid-template-columns: 12rem minmax(0, 1fr);
      align-items: start;
      gap: 2rem;
    }
  }
  @media (min-width: 64rem) {
    .about-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
      gap: clamp(3rem, 6vw, 7rem);
    }
    .about-photo {
      position: sticky;
      top: calc(var(--nav-h) + 3rem);
      width: min(100%, 24rem);
      margin-inline: 0;
      align-self: start;
    }
  }
</style>
