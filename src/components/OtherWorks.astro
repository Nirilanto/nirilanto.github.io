---
import SectionHeading from './SectionHeading.astro';
import { getOtherProjects } from '../lib/content';
import { toLocale, useTranslations } from '../i18n';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const projects = await getOtherProjects(locale);
---

<section class="section container-page" aria-labelledby="autres-title">
  <SectionHeading
    index="02"
    label={`${t('others.title')} ${t('others.titleOutline')}`}
    title={t('others.title')}
    outline={t('others.titleOutline')}
    id="autres-title"
  />

  <ul class="border-line border-t">
    {projects.map((project, i) => (
      <li class="work border-line border-b" data-reveal>
        <span class="label work-index">{String(i + 1).padStart(2, '0')}</span>
        <div class="work-head">
          <h3 class="work-title">{project.title}</h3>
          <p class="text-muted mt-2 font-mono text-xs tracking-wider uppercase">
            {project.client}
            {project.period && ` · ${project.period}`}
          </p>
        </div>
        <div class="work-body">
          <p class="max-w-[58ch]">{project.summary}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .work {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.75rem 1rem;
    padding-block: 1.75rem;
  }
  .work-index {
    padding-top: 0.5rem;
  }
  .work-body {
    grid-column: 2;
  }
  .work-title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1;
    transition: transform var(--duration-fast) var(--ease-expo);
  }
  .work:hover .work-title {
    transform: translateX(0.75rem);
  }
  @media (min-width: 64rem) {
    .work {
      grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 2rem;
      padding-block: 2.25rem;
    }
    .work-body {
      grid-column: auto;
    }
  }
</style>
