---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { heroCopy, nav, profile, site } from '../data/site';
import { localePath, toLocale, useTranslations } from '../i18n';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = localePath(locale, '/');
const { location } = profile[locale];
const { experience } = heroCopy[locale];
const links = nav.map((item) => ({
  label: t(item.key),
  href: localePath(locale, `/${item.hash}`),
}));
const contact = localePath(locale, '/#contact');
---

<header class="site-nav fixed inset-x-0 top-0 z-50" data-nav>
  <div class="container-page flex h-(--nav-h) items-center justify-between gap-6">
    <a href={home} class="nav-home min-h-11 min-w-0" aria-label={`${site.name} — ${t('nav.home')}`}>
      <!-- En haut de page : l'étiquette et la pastille (si la place le permet). Une fois le hero passé :
           l'avatar et le nom prennent sa place. -->
      <span class="nav-pill flex items-center gap-4 max-xl:hidden">
        <span class="label whitespace-nowrap">
          {t('hero.label')} — {location}
        </span>
        <span class="pill whitespace-nowrap">
          <span class="pill-dot" aria-hidden="true"></span>
          {experience}
        </span>
      </span>
      <span class="nav-id">
        <Image src={avatar} alt="" width={72} height={72} loading="eager" class="nav-avatar" />
        <span class="font-display text-sm font-bold tracking-tight whitespace-nowrap sm:text-base">
          {site.name}
        </span>
      </span>
    </a>

    <nav aria-label={t('nav.main')} class="hidden items-center gap-6 lg:flex xl:gap-8">
      <ul class="flex items-center gap-6 xl:gap-8">
        {links.map((item) => (
          <li>
            <a href={item.href} class="link nav-link flex min-h-11 items-center">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="flex items-center">
        <LangSwitch />
        <ThemeToggle />
      </div>
      <a href={contact} class="btn btn-primary" data-magnetic>
        {t('nav.contact')}
      </a>
    </nav>

    <div class="flex items-center lg:hidden">
      <LangSwitch />
      <ThemeToggle />
      <button
        type="button"
        class="flex size-11 items-center justify-center"
        aria-expanded="false"
        aria-controls="menu-mobile"
        data-menu-toggle
        data-label-open={t('menu.open')}
        data-label-close={t('menu.close')}
      >
        <span class="sr-only" data-menu-label>
          {t('menu.open')}
        </span>
        <span data-menu-icon="open">
          <Icon name="menu" size={24} />
        </span>
        <span data-menu-icon="close" hidden>
          <Icon name="close" size={24} />
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Hors du <header> : son backdrop-filter créerait le bloc conteneur du panneau fixe. -->
<div id="menu-mobile" class="menu-mobile z-40 lg:hidden" hidden>
  <nav aria-label={t('nav.mobile')} class="container-page flex h-full flex-col pt-6 pb-10">
    <ul class="flex flex-col">
      {links.map((item, i) => (
        <li class="border-line border-b">
          <a href={item.href} class="flex min-h-16 items-baseline gap-4 py-4" data-menu-link>
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-display text-4xl font-bold tracking-tighter">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <a href={contact} class="btn btn-primary mt-8 self-start" data-menu-link>
      {t('nav.contact')}
    </a>
  </nav>
</div>

<style>
  /* Transparent en haut de page ; le fond dépoli n'apparaît qu'une fois la page défilée. */
  .site-nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-expo);
  }
  :global(html.scrolled) .site-nav::before,
  :global(html.no-js) .site-nav::before {
    opacity: 1;
  }
  /* Pastille et identité partagent la même case : l'une s'efface quand l'autre arrive. */
  .nav-home {
    display: grid;
    align-items: center;
    justify-items: start;
  }
  .nav-pill,
  .nav-id {
    grid-area: 1 / 1;
    transition:
      opacity var(--duration-fast) var(--ease-expo),
      transform var(--duration-fast) var(--ease-expo);
  }
  .nav-id {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    transform: translateY(0.5rem);
  }
  .nav-id :global(.nav-avatar) {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    object-fit: cover;
  }
  :global(html.past-hero) .nav-id,
  :global(html.no-js) .nav-id {
    opacity: 1;
    transform: none;
  }
  :global(html.past-hero) .nav-pill,
  :global(html.no-js) .nav-pill {
    opacity: 0;
    transform: translateY(-0.5rem);
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color var(--duration-fast) var(--ease-expo);
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-fg);
  }
  .nav-link::after {
    bottom: 0.6rem;
    background: var(--color-accent);
  }
  .menu-mobile {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    background: var(--color-bg);
    overflow-y: auto;
  }
</style>

<script>
  function initMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = document.getElementById('menu-mobile');
    if (!toggle || !panel || toggle.dataset.ready) return;
    toggle.dataset.ready = 'true';

    const label = toggle.querySelector('[data-menu-label]');
    const iconOpen = toggle.querySelector<HTMLElement>('[data-menu-icon="open"]');
    const iconClose = toggle.querySelector<HTMLElement>('[data-menu-icon="close"]');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (label)
        label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
      if (iconOpen) iconOpen.hidden = open;
      if (iconClose) iconClose.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    panel
      .querySelectorAll('[data-menu-link]')
      .forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', () => setOpen(false));
  }

  // Fond de l'en-tête : seulement une fois la page défilée.
  // Identité (avatar et nom) : une fois le nom du hero sorti de l'écran ; sans hero, dès le départ.
  const syncScrolled = () => {
    const root = document.documentElement;
    root.classList.toggle('scrolled', window.scrollY > 24);
    const name = document.querySelector<HTMLElement>('#hero-title');
    root.classList.toggle('past-hero', !name || name.getBoundingClientRect().bottom < 72);
  };
  window.addEventListener('scroll', syncScrolled, { passive: true });

  document.addEventListener('astro:page-load', () => {
    initMenu();
    syncScrolled();
  });
</script>
