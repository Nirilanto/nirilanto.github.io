---
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';
import { localePath, toLocale, useTranslations } from '../i18n';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = localePath(locale, '/');
const links = nav.map((item) => ({
  label: t(item.key),
  href: localePath(locale, `/${item.hash}`),
}));
const contact = localePath(locale, '/#contact');
---

<header class="site-nav fixed inset-x-0 top-0 z-50" data-nav>
  <div class="container-page flex h-(--nav-h) items-center justify-between gap-6">
    <a
      href={home}
      class="font-display flex min-h-11 items-center text-lg font-bold tracking-tight"
      aria-label={`${site.name} — ${t('nav.home')}`}
    >
      <span>VN</span>
      <span class="text-accent">.</span>
    </a>

    <nav aria-label={t('nav.main')} class="hidden items-center gap-6 lg:flex xl:gap-8">
      <ul class="flex items-center gap-6 xl:gap-8">
        {links.map((item) => (
          <li>
            <a href={item.href} class="link nav-link flex min-h-11 items-center">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="flex items-center">
        <LangSwitch />
        <ThemeToggle />
      </div>
      <a href={contact} class="btn btn-primary" data-magnetic>
        {t('nav.contact')}
      </a>
    </nav>

    <div class="flex items-center lg:hidden">
      <LangSwitch />
      <ThemeToggle />
      <button
        type="button"
        class="flex size-11 items-center justify-center"
        aria-expanded="false"
        aria-controls="menu-mobile"
        data-menu-toggle
        data-label-open={t('menu.open')}
        data-label-close={t('menu.close')}
      >
        <span class="sr-only" data-menu-label>
          {t('menu.open')}
        </span>
        <span data-menu-icon="open">
          <Icon name="menu" size={24} />
        </span>
        <span data-menu-icon="close" hidden>
          <Icon name="close" size={24} />
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Hors du <header> : son backdrop-filter créerait le bloc conteneur du panneau fixe. -->
<div id="menu-mobile" class="menu-mobile z-40 lg:hidden" hidden>
  <nav aria-label={t('nav.mobile')} class="container-page flex h-full flex-col pt-6 pb-10">
    <ul class="flex flex-col">
      {links.map((item, i) => (
        <li class="border-line border-b">
          <a href={item.href} class="flex min-h-16 items-baseline gap-4 py-4" data-menu-link>
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-display text-4xl font-bold tracking-tighter">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <a href={contact} class="btn btn-primary mt-8 self-start" data-menu-link>
      {t('nav.contact')}
    </a>
  </nav>
</div>

<style>
  .site-nav {
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color var(--duration-fast) var(--ease-expo);
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-fg);
  }
  .nav-link::after {
    bottom: 0.6rem;
    background: var(--color-accent);
  }
  .menu-mobile {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    background: var(--color-bg);
    overflow-y: auto;
  }
</style>

<script>
  function initMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = document.getElementById('menu-mobile');
    if (!toggle || !panel || toggle.dataset.ready) return;
    toggle.dataset.ready = 'true';

    const label = toggle.querySelector('[data-menu-label]');
    const iconOpen = toggle.querySelector<HTMLElement>('[data-menu-icon="open"]');
    const iconClose = toggle.querySelector<HTMLElement>('[data-menu-icon="close"]');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (label)
        label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
      if (iconOpen) iconOpen.hidden = open;
      if (iconClose) iconClose.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    panel
      .querySelectorAll('[data-menu-link]')
      .forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 64rem)').addEventListener('change', () => setOpen(false));
  }

  document.addEventListener('astro:page-load', initMenu);
</script>
