---
/** Curseur personnalisé : point + anneau à la traîne. Souris uniquement, jamais en mouvement réduit. */
---

<div class="cursor" aria-hidden="true" data-cursor transition:persist="cursor">
  <div class="cursor-ring" data-cursor-ring>
    <span class="cursor-label" data-cursor-text></span>
  </div>
  <div class="cursor-dot" data-cursor-dot></div>
</div>

<style is:global>
  .cursor {
    display: none;
  }
  html.has-cursor,
  html.has-cursor * {
    cursor: none !important;
  }
  html.has-cursor .cursor {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-expo);
  }
  html.has-cursor .cursor.is-visible {
    opacity: 1;
  }
  .cursor-dot,
  .cursor-ring {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    will-change: transform;
  }
  .cursor-dot {
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    background: var(--color-accent);
  }
  .cursor-ring {
    display: grid;
    width: 80px;
    height: 80px;
    margin: -40px 0 0 -40px;
    place-items: center;
  }
  /* Le disque est un pseudo-élément : on anime son échelle sans déformer le libellé. */
  .cursor-ring::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 3px solid var(--color-accent);
    border-radius: 50%;
    opacity: 0.75;
    transform: scale(0.45);
    transition:
      transform var(--duration-fast) var(--ease-expo),
      opacity var(--duration-fast) var(--ease-expo),
      background-color var(--duration-fast) var(--ease-expo);
  }
  .cursor.is-link .cursor-ring::before {
    border-width: 2px;
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    opacity: 1;
    transform: scale(0.8);
  }
  .cursor.is-label .cursor-ring::before {
    border-width: 0;
    background: var(--color-accent);
    opacity: 1;
    transform: scale(1);
  }
  .cursor.is-down .cursor-ring::before {
    transform: scale(0.32);
  }
  .cursor.is-link .cursor-dot,
  .cursor.is-label .cursor-dot {
    opacity: 0;
  }
  .cursor-dot {
    transition: opacity var(--duration-fast) var(--ease-expo);
  }
  .cursor-label {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-on-accent);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-expo);
  }
  .cursor.is-label .cursor-label {
    opacity: 1;
  }
</style>

<script>
  import { animate, cancelFrame, frame } from 'motion';
  import { EASE } from '../lib/motion';

  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const INTERACTIVE = 'a, button, [role="button"], label, summary, [data-cursor-label]';

  let started = false;

  function start() {
    if (started || !fine.matches || reduced.matches) return;
    const root = document.querySelector<HTMLElement>('[data-cursor]');
    const dot = root?.querySelector<HTMLElement>('[data-cursor-dot]');
    const ring = root?.querySelector<HTMLElement>('[data-cursor-ring]');
    const text = root?.querySelector<HTMLElement>('[data-cursor-text]');
    if (!root || !dot || !ring || !text) return;
    started = true;

    const target = { x: 0, y: 0 };
    const trail = { x: 0, y: 0 };
    const place = (el: HTMLElement, x: number, y: number) => {
      el.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    };
    let seen = false;

    const describe = (el: Element | null) => {
      const hit = el?.closest(INTERACTIVE) ?? null;
      const label = hit?.closest<HTMLElement>('[data-cursor-label]')?.dataset.cursorLabel ?? '';
      root.classList.toggle('is-label', !!label);
      root.classList.toggle('is-link', !!hit && !label);
      if (label) text.textContent = label;
    };

    window.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse') return;
        target.x = event.clientX;
        target.y = event.clientY;
        if (!seen) {
          // Le curseur natif ne disparaît qu'une fois le nôtre réellement en place.
          seen = true;
          trail.x = target.x;
          trail.y = target.y;
          document.documentElement.classList.add('has-cursor');
        }
        root.classList.add('is-visible');
        describe(event.target as Element | null);
      },
      { passive: true },
    );
    window.addEventListener('pointerdown', () => root.classList.add('is-down'));
    window.addEventListener('pointerup', () => root.classList.remove('is-down'));
    document.documentElement.addEventListener('pointerleave', () =>
      root.classList.remove('is-visible'),
    );
    // Après une navigation, l'élément survolé a changé sans que la souris bouge.
    document.addEventListener('astro:after-swap', () => {
      root.classList.remove('is-label', 'is-link');
    });

    // Boucle de rendu de Motion : le point colle à la souris, l'anneau suit avec retard.
    const follow = () => {
      if (!seen) return;
      trail.x += (target.x - trail.x) * 0.18;
      trail.y += (target.y - trail.y) * 0.18;
      place(dot, target.x, target.y);
      place(ring, trail.x, trail.y);
    };
    frame.render(follow, true);
    window.addEventListener('pagehide', () => cancelFrame(follow), { once: true });

    // Boutons magnétiques : le bouton suit légèrement la souris, puis revient.
    let magnet: HTMLElement | null = null;
    const release = () => {
      if (!magnet) return;
      animate(magnet, { x: 0, y: 0 }, { duration: 0.8, ease: EASE });
      magnet = null;
    };
    window.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse') return;
        const el =
          (event.target as Element | null)?.closest<HTMLElement>('[data-magnetic]') ?? null;
        if (el !== magnet) release();
        if (!el) return;
        magnet = el;
        const box = el.getBoundingClientRect();
        // La boîte inclut déjà le décalage en cours : on le retire pour viser le centre au repos.
        const shift = new DOMMatrixReadOnly(getComputedStyle(el).transform);
        const dx = event.clientX - (box.left + box.width / 2) + shift.m41;
        const dy = event.clientY - (box.top + box.height / 2) + shift.m42;
        animate(el, { x: dx * 0.18, y: dy * 0.3 }, { duration: 0.4, ease: EASE });
      },
      { passive: true },
    );
    document.documentElement.addEventListener('pointerleave', release);
  }

  start();
  fine.addEventListener('change', start);
</script>
